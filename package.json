{
  "name": "vscode-stock-monitor-extension",
  "displayName": "Stock Monitor",
  "description": "在 VS Code 状态栏实时监控 A股 / 港股 / 美股行情，支持自选列表、收藏、持仓收益与涨跌配色",
  "version": "1.1.0",
  "publisher": "stock-monitor",
  "license": "MIT",
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Other"
  ],
  "keywords": [
    "股票",
    "行情",
    "stock",
    "A股",
    "港股",
    "美股",
    "状态栏",
    "自选股"
  ],
  "activationEvents": [
    "onStartupFinished",
    "onView:stockMonitorWatchList"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "stockMonitor.addStock",
        "title": "添加股票",
        "category": "Stock Monitor",
        "icon": "$(add)"
      },
      {
        "command": "stockMonitor.removeStock",
        "title": "移除股票",
        "category": "Stock Monitor",
        "icon": "$(trash)"
      },
      {
        "command": "stockMonitor.toggleFavorite",
        "title": "收藏 / 取消收藏股票",
        "category": "Stock Monitor",
        "icon": "$(star)"
      },
      {
        "command": "stockMonitor.setPosition",
        "title": "设置持仓（别名 / 成本价 / 数量）",
        "category": "Stock Monitor",
        "icon": "$(graph)"
      },
      {
        "command": "stockMonitor.refresh",
        "title": "立即刷新行情",
        "category": "Stock Monitor",
        "icon": "$(refresh)"
      },
      {
        "command": "stockMonitor.showLogs",
        "title": "显示运行日志",
        "category": "Stock Monitor",
        "icon": "$(output)"
      }
    ],
    "configuration": {
      "title": "Stock Monitor",
      "properties": {
        "stockMonitor.refreshInterval": {
          "type": "number",
          "default": 10,
          "minimum": 5,
          "maximum": 300,
          "markdownDescription": "行情自动刷新间隔（秒），取值范围 5 ~ 300。默认 `10`。"
        },
        "stockMonitor.statusBarAlignment": {
          "type": "string",
          "enum": [
            "left",
            "right"
          ],
          "enumDescriptions": [
            "状态栏左侧（靠近其他状态项）",
            "状态栏右侧（靠近通知区域）"
          ],
          "default": "left",
          "description": "行情信息在状态栏中的显示位置"
        },
        "stockMonitor.statusBarPriority": {
          "type": "number",
          "default": 100,
          "description": "状态栏优先级。数值越大越靠前（left 时越靠左，right 时越靠右），多只股票按关注列表顺序依次递减"
        },
        "stockMonitor.maxStatusBarItems": {
          "type": "number",
          "default": 6,
          "minimum": 1,
          "maximum": 20,
          "description": "状态栏最多展示的股票数量，收藏的股票优先展示"
        },
        "stockMonitor.showPortfolioSummary": {
          "type": "boolean",
          "default": true,
          "description": "是否在状态栏展示全部持仓的当日参考盈亏汇总项"
        },
        "stockMonitor.portfolioSummaryLabel": {
          "type": "string",
          "default": "参考盈亏",
          "description": "持仓汇总状态栏项的文案前缀，例如“参考盈亏”或“总当日盈亏”"
        },
        "stockMonitor.displayFields": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "name",
              "code",
              "price",
              "change",
              "changePercent",
              "high",
              "low",
              "open",
              "prevClose",
              "volume",
              "turnover",
              "time",
              "profit",
              "totalProfit"
            ]
          },
          "default": [
            "name",
            "price",
            "changePercent"
          ],
          "description": "状态栏展示字段及顺序。name=名称，price=最新价，change=涨跌额，changePercent=涨跌幅，profit=当日收益，totalProfit=持仓总收益，其余为最高/最低/今开/昨收/成交量/成交额/行情时间。收益类字段需在 stockMonitor.positions 中配置持仓数量"
        },
        "stockMonitor.colorScheme": {
          "type": "string",
          "order": 100,
          "enum": [
            "greenUp",
            "redUp"
          ],
          "enumDescriptions": [
            "上涨绿色、下跌红色（国际市场惯例，默认）",
            "上涨红色、下跌绿色（A 股投资者习惯）"
          ],
          "default": "greenUp",
          "description": "涨跌配色方案，平盘统一显示为灰色"
        },
        "stockMonitor.upColor": {
          "type": "string",
          "order": 101,
          "default": "",
          "pattern": "^$|^#(?:[0-9a-fA-F]{3}|[0-9a-fA-F]{6}|[0-9a-fA-F]{8})$",
          "description": "全局上涨颜色，支持十六进制色值，如 #22c55e。留空则按 colorScheme 方案显示"
        },
        "stockMonitor.downColor": {
          "type": "string",
          "order": 102,
          "default": "",
          "pattern": "^$|^#(?:[0-9a-fA-F]{3}|[0-9a-fA-F]{6}|[0-9a-fA-F]{8})$",
          "description": "全局下跌颜色，支持十六进制色值，如 #ef4444。留空则按 colorScheme 方案显示"
        },
        "stockMonitor.stockColors": {
          "type": "array",
          "order": 103,
          "default": [],
          "markdownDescription": "单只股票的涨跌颜色覆盖配置。数组元素包含：\n\n- `code`：股票代码，如 `sh600519` / `00700` / `AAPL`\n- `upColor`：该股票上涨颜色，支持十六进制色值\n- `downColor`：该股票下跌颜色，支持十六进制色值\n\n未配置的方向会自动回退到全局 `stockMonitor.upColor` / `stockMonitor.downColor`，若全局也未配置，则继续回退到 `stockMonitor.colorScheme`。",
          "items": {
            "type": "object",
            "required": [
              "code"
            ],
            "properties": {
              "code": {
                "type": "string",
                "description": "股票代码，如 sh600519 / 00700 / AAPL"
              },
              "upColor": {
                "type": "string",
                "pattern": "^$|^#(?:[0-9a-fA-F]{3}|[0-9a-fA-F]{6}|[0-9a-fA-F]{8})$",
                "description": "该股票上涨颜色，支持十六进制色值，如 #a855f7"
              },
              "downColor": {
                "type": "string",
                "pattern": "^$|^#(?:[0-9a-fA-F]{3}|[0-9a-fA-F]{6}|[0-9a-fA-F]{8})$",
                "description": "该股票下跌颜色，支持十六进制色值，如 #06b6d4"
              }
            }
          },
          "examples": [
            [
              {
                "code": "sz300866",
                "upColor": "#a855f7",
                "downColor": "#06b6d4"
              }
            ]
          ]
        },
        "stockMonitor.decimals": {
          "type": "number",
          "default": 2,
          "minimum": 0,
          "maximum": 4,
          "description": "价格显示保留的小数位数"
        },
        "stockMonitor.apiEndpoint": {
          "type": "string",
          "default": "https://qt.gtimg.cn",
          "description": "行情接口地址（腾讯财经行情接口）。若默认地址不可用，可替换为自建或第三方代理地址"
        },
        "stockMonitor.requestTimeout": {
          "type": "number",
          "default": 5000,
          "minimum": 1000,
          "maximum": 30000,
          "description": "单次行情请求超时时间（毫秒）"
        },
        "stockMonitor.watchList": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [
            "sh000001",
            "sz399001",
            "sh600519"
          ],
          "description": "默认关注列表，仅在首次启动（尚未保存过关注数据）时生效。例如 sh000001=上证指数、sz399001=深证成指、sh600519=贵州茅台、00700=腾讯控股、AAPL=苹果"
        },
        "stockMonitor.positions": {
          "type": "array",
          "default": [],
          "markdownDescription": "持仓配置，用于展示持仓收益。数组元素包含：\n\n- `code`：股票代码，格式同关注列表（如 `sh600519` / `00700` / `AAPL`）\n- `alias`：别名，配置后优先于股票名称展示\n- `costPrice`：持仓成本价（每股价）\n- `shares`：持仓数量（股）\n\n配置 `costPrice` 与 `shares` 后，状态栏与列表会实时计算：当日收益 =（最新价 − 昨收）× 持仓数量，持仓总收益 =（最新价 − 成本价）× 持仓数量。可用命令「Stock Monitor: 设置持仓」可视化维护。",
          "items": {
            "type": "object",
            "required": [
              "code"
            ],
            "properties": {
              "code": {
                "type": "string",
                "description": "股票代码，如 sh600519 / 00700 / AAPL"
              },
              "alias": {
                "type": "string",
                "description": "别名，展示时优先于股票名称"
              },
              "costPrice": {
                "type": "number",
                "description": "持仓成本价（每股价），需大于 0"
              },
              "shares": {
                "type": "number",
                "description": "持仓数量（股），需大于 0，配置后才会计算收益"
              }
            }
          },
          "examples": [
            [
              {
                "code": "sh600519",
                "alias": "茅台",
                "costPrice": 1200,
                "shares": 100
              }
            ]
          ]
        }
      }
    },
    "views": {
      "explorer": [
        {
          "id": "stockMonitorWatchList",
          "name": "股票关注列表",
          "contextualTitle": "Stock Monitor"
        }
      ]
    },
    "menus": {
      "view/title": [
        {
          "command": "stockMonitor.refresh",
          "when": "view == stockMonitorWatchList",
          "group": "navigation@1"
        },
        {
          "command": "stockMonitor.addStock",
          "when": "view == stockMonitorWatchList",
          "group": "navigation@2"
        }
      ],
      "view/item/context": [
        {
          "command": "stockMonitor.toggleFavorite",
          "when": "view == stockMonitorWatchList && viewItem == stockItem",
          "group": "inline@1"
        },
        {
          "command": "stockMonitor.toggleFavorite",
          "when": "view == stockMonitorWatchList && viewItem == stockItemFavorite",
          "group": "inline@1"
        },
        {
          "command": "stockMonitor.setPosition",
          "when": "view == stockMonitorWatchList && viewItem == stockItem",
          "group": "inline@2"
        },
        {
          "command": "stockMonitor.setPosition",
          "when": "view == stockMonitorWatchList && viewItem == stockItemFavorite",
          "group": "inline@2"
        },
        {
          "command": "stockMonitor.removeStock",
          "when": "view == stockMonitorWatchList && viewItem == stockItem",
          "group": "inline@3"
        },
        {
          "command": "stockMonitor.removeStock",
          "when": "view == stockMonitorWatchList && viewItem == stockItemFavorite",
          "group": "inline@3"
        }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "lint": "eslint src",
    "test:unit": "mocha --ui tdd \"out/test/unit/**/*.test.js\"",
    "pretest": "npm run compile && npm run lint",
    "test": "vscode-test",
    "vsix": "vsce package --allow-missing-repository"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "24.x",
    "@types/vscode": "~1.90.0",
    "@vscode/test-cli": "^0.0.15",
    "@vscode/test-electron": "^3.0.0",
    "@vscode/vsce": "^2.20.1",
    "eslint": "^10.5.0",
    "mocha": "^10.7.3",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.61.1"
  },
  "dependencies": {
    "iconv-lite": "^0.6.3"
  },
  "overrides": {
    "diff": "^8.0.4",
    "serialize-javascript": "^7.0.6"
  }
}
